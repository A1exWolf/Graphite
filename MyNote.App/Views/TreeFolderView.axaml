<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="450"
             x:Class="MyNote.App.Views.TreeFolderView"
             xmlns:vm="using:MyNote.App.ViewModels"
             xmlns:notes="using:MyNote.Domain.Notes"
             x:DataType="vm:MainViewModel">
  <Grid Margin="5, 10">
      <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBox Grid.Row="0" PlaceholderText="Поиск..." Margin="0,0,0,10"/>
      <!--<TreeView DoubleTapped="InputElement_OnDoubleTapped" ItemsSource="{Binding Tree}">
              <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="models:TreeFolderModel" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Name}" />
                  </TreeDataTemplate>
              </TreeView.ItemTemplate>
          </TreeView>-->
      <ListBox Grid.Row="1" ItemsSource="{Binding Notes}">
          <ListBox.ItemTemplate>
              <DataTemplate x:DataType="notes:NoteInfo">
                  <TextBlock Text="{Binding RelativePath}"/>
              </DataTemplate>
          </ListBox.ItemTemplate>
      </ListBox>
  </Grid>
</UserControl>