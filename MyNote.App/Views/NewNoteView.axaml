<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyNote.App.ViewModels"
             x:Class="MyNote.App.Views.NewNoteView"
             x:DataType="vm:NewNoteViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <TextBox
            PlaceholderText="Название заметки"
            Text="{Binding Name}"/>

        <ComboBox
            Grid.Row="1"
            PlaceholderText="Выберите папку"
            SelectedItem="{Binding SelectedFolderPath}"
            ItemsSource="{Binding Folders}"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="IndianRed"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                Content="Отмена"
                Command="{Binding CancelCommand}"/>

            <Button
                Grid.Column="2"
                Content="Создать"
                Command="{Binding CreateCommand}"/>
        </Grid>
    </Grid>
</UserControl>