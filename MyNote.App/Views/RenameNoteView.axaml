<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyNote.App.ViewModels"
             x:Class="MyNote.App.Views.RenameNoteView"
             x:DataType="vm:RenameNoteViewModel"
             Width="300"
             Height="110">

    <Grid RowDefinitions="Auto, Auto, *" 
          RowSpacing="16" 
          Margin="10">
        
        <TextBox Grid.Row="0" 
                 PlaceholderText="Enter new title for note" 
                 Text="{Binding Name}" />
        
        <Grid Grid.Row="1" 
              ColumnDefinitions="Auto, Auto" 
              ColumnSpacing="8" 
              HorizontalAlignment="Center">
            
            <Button Grid.Column="0" 
                    IsEnabled="{Binding !IsSaveInProcces}" 
                    Content="Cancel" 
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1" 
                    IsEnabled="{Binding !IsSaveInProcces}" 
                    Content="Rename" 
                    Command="{Binding RenameCommand}"/>
        </Grid>
        
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                   Foreground="IndianRed"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>