<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyNote.App.Views.TabControlView"
             xmlns:vm="using:MyNote.App.ViewModels"
             x:DataType="vm:MainViewModel">
    <Grid>
        <StackPanel IsVisible="{Binding !EditorTabsViewModel.OpenNotes.Count}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Выберите или создайте заметку" FontSize="30" Margin="0,0,0,10" />
            <Button Content="Создать заметку" HorizontalAlignment="Center" Command="{Binding OpenNewNoteCommand}"/>
        </StackPanel>

        <TabControl Margin="5,10"
                    IsVisible="{Binding EditorTabsViewModel.OpenNotes.Count}"
                    ItemsSource="{Binding EditorTabsViewModel.OpenNotes }"
                    SelectedItem="{Binding EditorTabsViewModel.SelectedNote}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteTabViewModel">
                    <StackPanel Orientation="Horizontal" MaxHeight="30" VerticalAlignment="Center">
                        <TextBlock
                            MaxWidth="180"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Content="x"
                            FontSize="10"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext)?.EditorTabsViewModel.CloseTabCommand}"
                            CommandParameter="{Binding}"
                            MaxHeight="25"
                            Margin="5,0,0,0"
                            Background="Red"
                            Foreground="White"
                            CornerRadius="15"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:NoteTabViewModel">
                    <Grid
                        RowDefinitions="Auto,*"
                        ColumnDefinitions="*, *"
                        RowSpacing="8">

                        <TextBox
                            Grid.Row="0" Grid.Column="0" Text="{Binding Title, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="0" Grid.Column="1" Text="{Binding StatusSave}" />

                        <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            Text="{Binding Content, Mode=TwoWay}"
                            TextWrapping="Wrap"/>

                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>