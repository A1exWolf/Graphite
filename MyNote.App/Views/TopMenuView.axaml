<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyNote.App.Views.TopMenuView"
             xmlns:vm="using:MyNote.App.ViewModels"
             x:DataType="vm:MainViewModel">
    <DockPanel >
        <Menu DockPanel.Dock="Top">
            <MenuItem  Header="_Vault">
                <MenuItem Header="_Refresh" Click="Refresh_OnClick"/>
                <MenuItem Header="_Close" Click="CloseVault_OnClick"/>
            </MenuItem>
            <MenuItem  Header="_File">
                <MenuItem Header="_Create" Command="{Binding OpenNewNoteCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Rename" 
                          Command="{Binding RenemeNoteCommand}" 
                          InputGesture="F2"/>
                <MenuItem Header="_Delete" 
                          Command="{Binding DeleteNoteCommand}" 
                          InputGesture="Delete"/>
            </MenuItem>
        </Menu>
    </DockPanel>
</UserControl>
